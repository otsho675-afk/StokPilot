rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function ws(uid) { return /databases/$(database)/documents/workspaces/$(uid); }
    function product(uid, id) { return /databases/$(database)/documents/workspaces/$(uid)/products/$(id); }
    function entitlement(uid) { return /databases/$(database)/documents/workspaces/$(uid)/entitlements/current; }
    function premium(uid) {
      return exists(entitlement(uid)) &&
        get(entitlement(uid)).data.status == 'active' &&
        (get(entitlement(uid)).data.source == 'direct-store' ||
          (uid == 'gbw2USpZ8cNtcSyge5a2BEwJw3E3' &&
            get(entitlement(uid)).data.source == 'review')) &&
        get(entitlement(uid)).data.expiresAt is timestamp &&
        get(entitlement(uid)).data.expiresAt > request.time;
    }
    function intBetween(value, min, max) { return value is int && value >= min && value <= max; }
    function money(value) { return intBetween(value, 0, 1000000000000); }
    function signedMoney(value) { return intBetween(value, -1000000000000, 1000000000000); }
    function named(value) { return value is string && value.size() > 0 && value.size() <= 150; }
    // Server-only purchase token bindings; clients must never read or write purchase credentials.
    match /billingPurchases/{id} { allow read, write: if false; }
    match /workspaces/{uid} {
      allow read: if owner(uid);
      allow delete: if false; // quota anchor survives account-data deletion
      allow create: if owner(uid) &&
        request.resource.data.keys().hasOnly(['ownerUid','name','currency','productCount','createdAt']) &&
        request.resource.data.ownerUid == uid &&
        named(request.resource.data.name) &&
        request.resource.data.currency == 'TRY' &&
        request.resource.data.productCount == 0 &&
        request.resource.data.createdAt == request.time;
      // One counter update = exactly one product ID; a batch cannot add 51st product.
      allow update: if owner(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['productCount','lastProductId']) &&
        !('deletedAt' in resource.data) &&
        intBetween(resource.data.productCount, 0, 1999999999) &&
        request.resource.data.productCount == resource.data.productCount + 1 &&
        request.resource.data.lastProductId is string &&
        request.resource.data.lastProductId.size() > 0 &&
        !exists(product(uid, request.resource.data.lastProductId)) &&
        existsAfter(product(uid, request.resource.data.lastProductId)) &&
        (resource.data.productCount < 50 || premium(uid))) ||
        // Account erase leaves only a non-reusable technical quota anchor.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','deletedAt']) &&
          !('deletedAt' in resource.data) &&
          request.resource.data.name == 'Hesap silindi' &&
          request.resource.data.deletedAt == request.time)
      );
      match /entitlements/{id} {
        allow read, delete: if owner(uid);
        // A store-receipt-verifying external server must write Pro entitlement.
        allow create, update: if false;
      }
      match /settings/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && id == 'alerts' &&
          request.resource.data.keys().hasOnly(['priceReminderDays','lowStockAlerts']) &&
          request.resource.data.priceReminderDays in [30,45,60,90,180] &&
          request.resource.data.lowStockAlerts is bool;
        allow delete: if owner(uid);
      }
      match /categories/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['name','createdAt']) &&
          named(request.resource.data.name) &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          named(request.resource.data.name);
      }
      match /units/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['name','symbol','createdAt']) &&
          named(request.resource.data.name) &&
          request.resource.data.symbol is string &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','symbol']) &&
          named(request.resource.data.name) &&
          request.resource.data.symbol is string;
      }
      match /taxRates/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['name','rateBps','createdAt']) &&
          named(request.resource.data.name) &&
          intBetween(request.resource.data.rateBps, 0, 10000) &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','rateBps']) &&
          named(request.resource.data.name) &&
          intBetween(request.resource.data.rateBps, 0, 10000);
      }
      match /products/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          !('deletedAt' in get(ws(uid)).data) &&
          (get(ws(uid)).data.productCount < 50 || premium(uid)) &&
          getAfter(ws(uid)).data.productCount == get(ws(uid)).data.productCount + 1 &&
          getAfter(ws(uid)).data.lastProductId == id &&
          request.resource.data.keys().hasOnly([
            'name','sku','barcode','categoryId','unitId','taxRateBps',
            'purchasePriceMinor','salePriceMinor','minStockMilli',
            'isActive','stockMilli','priceChangedAt','createdAt'
          ]) &&
          named(request.resource.data.name) &&
          request.resource.data.sku is string &&
          request.resource.data.barcode is string &&
          request.resource.data.categoryId is string &&
          request.resource.data.unitId is string &&
          intBetween(request.resource.data.taxRateBps, 0, 10000) &&
          money(request.resource.data.purchasePriceMinor) &&
          money(request.resource.data.salePriceMinor) &&
          money(request.resource.data.minStockMilli) &&
          request.resource.data.isActive is bool &&
          request.resource.data.stockMilli == 0 &&
          request.resource.data.priceChangedAt == request.time &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','sku','barcode','categoryId','unitId','taxRateBps',
            'purchasePriceMinor','salePriceMinor','minStockMilli',
            'isActive','stockMilli','priceChangedAt'
          ]) &&
          named(request.resource.data.name) &&
          request.resource.data.sku is string &&
          request.resource.data.barcode is string &&
          request.resource.data.categoryId is string &&
          request.resource.data.unitId is string &&
          request.resource.data.isActive is bool &&
          intBetween(request.resource.data.taxRateBps, 0, 10000) &&
          money(request.resource.data.purchasePriceMinor) &&
          money(request.resource.data.salePriceMinor) &&
          money(request.resource.data.minStockMilli) &&
          money(request.resource.data.stockMilli) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priceChangedAt']) ||
            (request.resource.data.priceChangedAt == request.time &&
              request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'purchasePriceMinor','salePriceMinor'])));
      }
      match /contacts/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['name','type','phone','email','taxNumber','address','contactPerson','taxOffice','iban','balanceMinor','createdAt']) &&
          named(request.resource.data.name) &&
          request.resource.data.type in ['customer','supplier','both'] &&
          (!('contactPerson' in request.resource.data) ||
            request.resource.data.contactPerson is string && request.resource.data.contactPerson.size() <= 150) &&
          (!('taxOffice' in request.resource.data) ||
            request.resource.data.taxOffice is string && request.resource.data.taxOffice.size() <= 100) &&
          (!('iban' in request.resource.data) ||
            request.resource.data.iban is string && request.resource.data.iban.size() <= 34) &&
          request.resource.data.balanceMinor == 0 &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','phone','email','taxNumber','address','contactPerson','taxOffice','iban','balanceMinor']) &&
          named(request.resource.data.name) &&
          request.resource.data.type in ['customer','supplier','both'] &&
          (!('contactPerson' in request.resource.data) ||
            request.resource.data.contactPerson is string && request.resource.data.contactPerson.size() <= 150) &&
          (!('taxOffice' in request.resource.data) ||
            request.resource.data.taxOffice is string && request.resource.data.taxOffice.size() <= 100) &&
          (!('iban' in request.resource.data) ||
            request.resource.data.iban is string && request.resource.data.iban.size() <= 34) &&
          signedMoney(request.resource.data.balanceMinor);
      }
      match /trades/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['type','contactId','contactName','lines','paidMinor','paymentMethod','documentKind','documentNo','externalDocumentNo','projectName','netMinor','taxMinor','totalMinor','note','createdAt']) &&
          request.resource.data.type in ['sale','purchase'] &&
          (!('contactName' in request.resource.data) ||
            request.resource.data.contactName is string && request.resource.data.contactName.size() <= 150) &&
          (!('documentKind' in request.resource.data) ||
            request.resource.data.documentKind in ['receipt','invoice','project']) &&
          (!('documentNo' in request.resource.data) ||
            request.resource.data.documentNo is string && request.resource.data.documentNo.size() <= 150) &&
          (!('externalDocumentNo' in request.resource.data) ||
            request.resource.data.externalDocumentNo is string && request.resource.data.externalDocumentNo.size() <= 100) &&
          (!('projectName' in request.resource.data) ||
            request.resource.data.projectName is string && request.resource.data.projectName.size() <= 150) &&
          (!('paymentMethod' in request.resource.data) ||
            request.resource.data.paymentMethod in ['cash','card','credit','partial']) &&
          request.resource.data.lines is list &&
          request.resource.data.lines.size() > 0 &&
          request.resource.data.lines.size() <= 30 &&
          money(request.resource.data.netMinor) &&
          money(request.resource.data.taxMinor) &&
          money(request.resource.data.totalMinor) &&
          money(request.resource.data.paidMinor) &&
          request.resource.data.paidMinor <= request.resource.data.totalMinor &&
          // When a new payment method is supplied, settled and credit
          // sales must be internally consistent.
          (request.resource.data.type != 'sale' ||
            !('paymentMethod' in request.resource.data) ||
            (request.resource.data.paymentMethod in ['cash','card'] &&
              request.resource.data.paidMinor == request.resource.data.totalMinor) ||
            (request.resource.data.paymentMethod == 'credit' &&
              request.resource.data.paidMinor == 0 &&
              request.resource.data.contactId is string &&
              request.resource.data.contactId.size() > 0)) &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
      }
      match /stockMoves/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['productId','tradeId','deltaMilli','reason','note','createdAt']) &&
          request.resource.data.productId is string &&
          request.resource.data.deltaMilli is int &&
          request.resource.data.deltaMilli != 0 &&
          request.resource.data.reason in ['sale','purchase','adjustment'] &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
      }
      match /payments/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly(['contactId','tradeId','accountEntryId','type','amountMinor','auto','method','note','createdAt']) &&
          request.resource.data.type in ['collection','payout'] &&
          (!('accountEntryId' in request.resource.data) ||
            request.resource.data.accountEntryId == null ||
            (request.resource.data.accountEntryId is string &&
              request.resource.data.accountEntryId.size() > 0)) &&
          (!('method' in request.resource.data) ||
            request.resource.data.method in ['cash','card','credit','partial']) &&
          (!('note' in request.resource.data) ||
            request.resource.data.note is string && request.resource.data.note.size() <= 500) &&
          money(request.resource.data.amountMinor) &&
          request.resource.data.amountMinor > 0 &&
          request.resource.data.auto is bool &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
      }
      match /accountEntries/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasAll(['contactId','kind','documentKind','reference','projectName','note','amountMinor','settledMinor','effectiveAt','createdAt']) &&
          request.resource.data.keys().hasOnly(['contactId','kind','documentKind','reference','projectName','note','amountMinor','settledMinor','effectiveAt','dueAt','createdAt']) &&
          request.resource.data.contactId is string && request.resource.data.contactId.size() > 0 &&
          request.resource.data.kind in ['supplierDebt','customerReceivable'] &&
          request.resource.data.documentKind in ['opening','invoice','project'] &&
          request.resource.data.reference is string && request.resource.data.reference.size() <= 100 &&
          request.resource.data.projectName is string && request.resource.data.projectName.size() <= 150 &&
          request.resource.data.note is string && request.resource.data.note.size() <= 500 &&
          money(request.resource.data.amountMinor) && request.resource.data.amountMinor > 0 &&
          request.resource.data.settledMinor == 0 &&
          request.resource.data.effectiveAt is timestamp &&
          request.resource.data.effectiveAt <= request.time &&
          (!('dueAt' in request.resource.data) ||
            request.resource.data.dueAt == null ||
            (request.resource.data.dueAt is timestamp &&
              request.resource.data.dueAt >= request.resource.data.effectiveAt)) &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settledMinor']) &&
          money(request.resource.data.settledMinor) &&
          request.resource.data.settledMinor >= resource.data.settledMinor &&
          request.resource.data.settledMinor <= resource.data.amountMinor;
      }
      match /expenses/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasAll(['title','category','method','amountMinor','note','createdAt']) &&
          request.resource.data.keys().hasOnly(['title','category','method','amountMinor','note','createdAt']) &&
          named(request.resource.data.title) &&
          request.resource.data.category in ['rent','utilities','salary','transport','marketing','other'] &&
          request.resource.data.method in ['cash','card','bank'] &&
          money(request.resource.data.amountMinor) &&
          request.resource.data.amountMinor > 0 &&
          request.resource.data.note is string &&
          request.resource.data.note.size() <= 500 &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if owner(uid);
      }
      match /billingEvents/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if false;
      }
    }
  }
}
